{
  "name": "aion-desk",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "start": "node scripts/vertice-server.mjs",
    "preview": "vite preview",
    "server:doctor": "node scripts/vertice-ctl.mjs doctor",
    "server:start": "node scripts/vertice-ctl.mjs start",
    "server:status": "node scripts/vertice-ctl.mjs status",
    "server:stop": "node scripts/vertice-ctl.mjs stop",
    "clean": "node -e \"import('node:fs').then((fs)=>{for(const p of ['dist','server.js','test-results','playwright-report'])fs.rmSync(p,{recursive:true,force:true})})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
