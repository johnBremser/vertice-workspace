# Endereço base opcional do AionCore local para chamadas HTTP/WS.
# Deixe vazio para usar mesma origem (proxy Vite ou scripts/vertice-server.mjs).
VITE_AIONCORE_BASE_URL=""

# Alvo opcional do proxy reverso (/api, /health, /login, /logout, /ws).
# Exemplo local: VITE_AIONCORE_PROXY_TARGET="http://127.0.0.1:25808"
VITE_AIONCORE_PROXY_TARGET=""

# Porta e host opcionais para scripts/vertice-server.mjs (padrão seguro: 127.0.0.1:4173)
# VERTICE_HOST="127.0.0.1"
# VERTICE_PORT="4173"
